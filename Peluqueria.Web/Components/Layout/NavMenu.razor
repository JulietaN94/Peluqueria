@using Peluqueria.Web.State
@inject ReservaNavegacionState ReservaNavegacion
@implements IDisposable

<nav class="site-nav onda-container" aria-label="Navegación principal">
    @* Enlace HTML normal para que el CSS Isolation aplique el estilo al logo. *@
    <a class="brand" href="/" @onclick="CerrarMenu" aria-label="ONDA Peluquería, ir al inicio">
        <span class="brand-main">ONDA</span>
        <span class="brand-sub">PELUQUERÍA</span>
    </a>

    <button type="button"
            class="menu-toggle"
            aria-label="@(menuAbierto ? "Cerrar menú" : "Abrir menú")"
            aria-controls="onda-nav-links"
            aria-expanded="@menuAbierto"
            @onclick="AlternarMenu">
        <span></span><span></span><span></span>
    </button>

    <div id="onda-nav-links" class="nav-links @(menuAbierto ? "open" : "")">
        <a href="/#servicios" @onclick="CerrarMenu">Servicios</a>
        <a href="/#nosotros" @onclick="CerrarMenu">Nosotros</a>
        <a href="/#equipo" @onclick="CerrarMenu">Equipo</a>
        <a href="/#galeria" @onclick="CerrarMenu">Galería</a>
        <a href="/#contacto" @onclick="CerrarMenu">Contacto</a>
        <a href="/mi-reserva" @onclick="CerrarMenu">Mi reserva</a>
        <a class="nav-cta" href="/reservar" @onclick="CerrarMenu">@(ReservaNavegacion.TieneReservaEnCurso ? "Continuar reserva" : "Reservar turno") <span aria-hidden="true">↗</span></a>
    </div>
</nav>

@code {
    private bool menuAbierto;

    protected override void OnInitialized()
    {
        ReservaNavegacion.Cambio += ActualizarNavegacion;
    }

    private void ActualizarNavegacion() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ReservaNavegacion.Cambio -= ActualizarNavegacion;
    }

    private void AlternarMenu() => menuAbierto = !menuAbierto;
    private void CerrarMenu() => menuAbierto = false;
}

