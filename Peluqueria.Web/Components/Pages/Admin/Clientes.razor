@page "/admin/clientes"
@using Microsoft.AspNetCore.Authorization
@using Peluqueria.Web.Components.Shared
@using Peluqueria.Application.Interfaces
@using Peluqueria.Application.DTOs.Clientes
@using Peluqueria.Application.DTOs.Comun
@attribute [Authorize(Roles = "Administrador")]
@inject IClienteService ClientesService
@inject ILogger<Clientes> Logger

<section class="onda-admin-page onda-container">
    <span class="eyebrow">ADMINISTRACIÓN · CONTACTOS</span>
    <h1>Clientes.</h1>
    <p class="onda-admin-intro">Consultá y administrá datos personales únicamente desde una cuenta administradora.</p>
    <AdminNavegacion />

    @if (!string.IsNullOrEmpty(Aviso)) { <p role="status" class="onda-admin-success">@Aviso</p> }
    @if (!string.IsNullOrEmpty(Error)) { <p role="alert" class="onda-admin-alert">@Error</p> }

    <div class="onda-admin-toolbar">
        <SearchBox Value="@Busqueda" ValueChanged="BuscarAsync" Etiqueta="Buscar clientes" Placeholder="Nombre o teléfono..." />
        <button type="button" class="onda-admin-primary" @onclick="Nuevo">+ Nuevo cliente</button>
    </div>

    @if (MostrarFormulario)
    {
        <div class="onda-admin-panel" @key="Formulario">
            <h2>@(EditandoId.HasValue ? "Editar cliente" : "Nuevo cliente")</h2>
            <EditForm Model="@Formulario" OnValidSubmit="GuardarAsync" class="onda-admin-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="onda-admin-form-grid">
                    <div class="onda-admin-field">
                        <label for="cli-nombre">Nombre completo *</label>
                        <InputText id="cli-nombre" @bind-Value="Formulario.NombreCompleto" />
                        <ValidationMessage For="@(() => Formulario.NombreCompleto)" />
                    </div>
                    <div class="onda-admin-field">
                        <label for="cli-telefono">Teléfono *</label>
                        <InputText id="cli-telefono" @bind-Value="Formulario.Telefono" />
                        <ValidationMessage For="@(() => Formulario.Telefono)" />
                    </div>
                    <div class="onda-admin-field onda-admin-span-2">
                        <label for="cli-obs">Observaciones internas</label>
                        <InputTextArea id="cli-obs" @bind-Value="Formulario.Observaciones" />
                        <ValidationMessage For="@(() => Formulario.Observaciones)" />
                    </div>
                    @if (EditandoId.HasValue)
                    {
                        <div class="onda-admin-field onda-admin-span-2">
                            <label class="onda-admin-check"><InputCheckbox @bind-Value="Formulario.Activo" /> Cliente activo</label>
                        </div>
                    }
                </div>
                <div class="onda-admin-actions">
                    <button type="submit" class="onda-admin-primary" disabled="@Procesando">@(Procesando ? "Guardando..." : "Guardar cliente")</button>
                    <button type="button" class="onda-admin-secondary" @onclick="CancelarEdicion" disabled="@Procesando">Cancelar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (Cargando) { <p role="status">Cargando clientes...</p> }
    else
    {
        <div class="onda-admin-table-wrap">
            <table class="onda-admin-table">
                <thead><tr><th scope="col">Cliente</th><th scope="col">Teléfono</th><th scope="col">Alta</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Resultados.Items)
                    {
                        <tr>
                            <td><strong>@item.NombreCompleto</strong></td>
                            <td>@item.Telefono</td>
                            <td>@item.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td><span class="onda-admin-state @(item.Activo ? "activo" : "inactivo")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                            <td class="onda-admin-row-actions">
                                <button type="button" class="onda-admin-secondary" @onclick="() => Editar(item)">Editar</button>
                                @if (item.Activo)
                                {
                                    <button type="button" class="onda-admin-danger" @onclick="() => SolicitarDesactivar(item)">Desactivar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Resultados.Items.Count == 0) { <p class="onda-admin-empty">No se encontraron clientes.</p> }
        </div>
        <Pagination PaginaActual="@Pagina" PaginaActualChanged="CambiarPaginaAsync" TotalRegistros="@Resultados.TotalRegistros" TamanoPagina="@TamanoPagina" />
    }
    <ConfirmDialog Abierto="@ConfirmarDesactivacion" Procesando="@Procesando"
                   Titulo="Desactivar cliente" Mensaje="El cliente quedará inactivo, sin eliminar su historial de turnos."
                   TextoConfirmar="Sí, desactivar" TextoCancelar="Volver"
                   OnConfirmar="DesactivarAsync" OnCancelar="CerrarConfirmacion" />
</section>

@code {
    private const int TamanoPagina = 10;
    private PaginaResultadoDto<ClienteDto> Resultados = new();
    private ClienteFormDto Formulario = new();
    private string Busqueda = "";
    private string? Aviso, Error;
    private int Pagina = 1;
    private int? EditandoId, DesactivarId;
    private bool MostrarFormulario, ConfirmarDesactivacion, Procesando, Cargando;
    private int VersionBusqueda;

    protected override async Task OnInitializedAsync() => await CargarAsync();
    private async Task CargarAsync()
    {
        var version = ++VersionBusqueda;
        Cargando = true;
        try
        {
            var datos = await ClientesService.ListarAsync(Busqueda, Pagina, TamanoPagina);
            if (version == VersionBusqueda) Resultados = datos;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al listar clientes");
            if (version == VersionBusqueda) Error = "No se pudieron cargar los clientes.";
        }
        finally { if (version == VersionBusqueda) Cargando = false; }
    }
    private async Task BuscarAsync(string texto) { Busqueda = texto; Pagina = 1; await CargarAsync(); }
    private async Task CambiarPaginaAsync(int pagina) { Pagina = pagina; await CargarAsync(); }
    private void Nuevo() { Error = Aviso = null; EditandoId = null; Formulario = new(); MostrarFormulario = true; }
    private void Editar(ClienteDto dato)
    {
        Error = Aviso = null;
        EditandoId = dato.ClienteId;
        Formulario = new() { ClienteId = dato.ClienteId, NombreCompleto = dato.NombreCompleto,
            Telefono = dato.Telefono, Observaciones = dato.Observaciones, Activo = dato.Activo };
        MostrarFormulario = true;
    }
    private void CancelarEdicion() => MostrarFormulario = false;
    private async Task GuardarAsync()
    {
        if (Procesando) return;
        Procesando = true; Error = Aviso = null;
        try
        {
            if (EditandoId.HasValue) await ClientesService.ActualizarAsync(EditandoId.Value, Formulario);
            else await ClientesService.CrearAsync(Formulario);
            MostrarFormulario = false;
            Aviso = "Cliente guardado correctamente.";
            Pagina = 1;
            await CargarAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al guardar cliente"); Error = "No se pudo guardar el cliente. Revisá los datos."; }
        finally { Procesando = false; }
    }
    private void SolicitarDesactivar(ClienteDto dato) { DesactivarId = dato.ClienteId; ConfirmarDesactivacion = true; }
    private void CerrarConfirmacion() { ConfirmarDesactivacion = false; DesactivarId = null; }
    private async Task DesactivarAsync()
    {
        if (Procesando || DesactivarId is not int id) return;
        Procesando = true; Error = Aviso = null;
        try
        {
            await ClientesService.DesactivarAsync(id);
            Aviso = "Cliente desactivado.";
            CerrarConfirmacion();
            await CargarAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al desactivar cliente"); Error = "No se pudo desactivar el cliente."; }
        finally { Procesando = false; }
    }
}
