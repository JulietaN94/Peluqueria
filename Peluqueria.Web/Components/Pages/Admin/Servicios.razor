@page "/admin/servicios"
@using Microsoft.AspNetCore.Authorization
@using Peluqueria.Web.Components.Shared
@using Peluqueria.Application.Interfaces
@using Peluqueria.Application.DTOs.Servicios
@using Peluqueria.Application.DTOs.Comun
@using Peluqueria.Web.Models
@attribute [Authorize(Roles = "Administrador")]
@inject IServicioService ServiciosService
@inject ILogger<Servicios> Logger

<section class="onda-admin-page onda-container">
    <span class="eyebrow">ADMINISTRACIÓN · CATÁLOGO</span>
    <h1>Servicios.</h1>
    <p class="onda-admin-intro">Administrá los servicios, sus precios y duraciones sin modificar la lógica de reservas.</p>
    <AdminNavegacion />

    @if (!string.IsNullOrEmpty(Aviso)) { <p role="status" class="onda-admin-success">@Aviso</p> }
    @if (!string.IsNullOrEmpty(Error)) { <p role="alert" class="onda-admin-alert">@Error</p> }

    <div class="onda-admin-toolbar">
        <SearchBox Value="@Busqueda" ValueChanged="BuscarAsync" Etiqueta="Buscar servicios" Placeholder="Nombre o descripción..." />
        <button type="button" class="onda-admin-primary" @onclick="Nuevo">+ Nuevo servicio</button>
    </div>

    @if (MostrarFormulario)
    {
        <div class="onda-admin-panel" @key="Formulario">
            <h2>@(EditandoId.HasValue ? "Editar servicio" : "Nuevo servicio")</h2>
            <EditForm Model="@Formulario" OnValidSubmit="GuardarAsync" class="onda-admin-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="onda-admin-form-grid">
                    <div class="onda-admin-field">
                        <label for="ser-nombre">Nombre *</label>
                        <InputText id="ser-nombre" @bind-Value="Formulario.Nombre" />
                        <ValidationMessage For="@(() => Formulario.Nombre)" />
                    </div>
                    <div class="onda-admin-field">
                        <label for="ser-precio">Precio (ARS) *</label>
                        <InputNumber id="ser-precio" @bind-Value="Formulario.Precio" min="0" step="0.01" />
                        <ValidationMessage For="@(() => Formulario.Precio)" />
                    </div>
                    <div class="onda-admin-field">
                        <label for="ser-duracion">Duración (minutos) *</label>
                        <InputNumber id="ser-duracion" @bind-Value="Formulario.DuracionMinutos" min="1" />
                        <ValidationMessage For="@(() => Formulario.DuracionMinutos)" />
                    </div>
                    <div class="onda-admin-field">
                        <label for="ser-img">URL de imagen (opcional)</label>
                        <InputText id="ser-img" @bind-Value="Formulario.ImagenUrl" />
                        <ValidationMessage For="@(() => Formulario.ImagenUrl)" />
                    </div>
                    <div class="onda-admin-field onda-admin-span-2">
                        <label for="ser-desc">Descripción</label>
                        <InputTextArea id="ser-desc" @bind-Value="Formulario.Descripcion" />
                        <ValidationMessage For="@(() => Formulario.Descripcion)" />
                    </div>
                    @if (EditandoId.HasValue)
                    {
                        <div class="onda-admin-field onda-admin-span-2">
                            <label class="onda-admin-check"><InputCheckbox @bind-Value="Formulario.Activo" /> Servicio activo</label>
                        </div>
                    }
                </div>
                <div class="onda-admin-actions">
                    <button type="submit" class="onda-admin-primary" disabled="@Procesando">@(Procesando ? "Guardando..." : "Guardar servicio")</button>
                    <button type="button" class="onda-admin-secondary" @onclick="CancelarEdicion" disabled="@Procesando">Cancelar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (Cargando) { <p role="status">Cargando servicios...</p> }
    else
    {
        <div class="onda-admin-table-wrap">
            <table class="onda-admin-table">
                <thead><tr><th scope="col">Servicio</th><th scope="col">Duración</th><th scope="col">Precio</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Resultados.Items)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong><small>@item.Descripcion</small></td>
                            <td>@item.DuracionMinutos min</td>
                            <td>@item.Precio.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</td>
                            <td><span class="onda-admin-state @(item.Activo ? "activo" : "inactivo")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                            <td class="onda-admin-row-actions">
                                <button type="button" class="onda-admin-secondary" @onclick="() => Editar(item)">Editar</button>
                                @if (item.Activo)
                                {
                                    <button type="button" class="onda-admin-danger" @onclick="() => SolicitarDesactivar(item)">Desactivar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Resultados.Items.Count == 0) { <p class="onda-admin-empty">No hay servicios que coincidan con tu búsqueda.</p> }
        </div>
        <Pagination PaginaActual="@Pagina" PaginaActualChanged="CambiarPaginaAsync" TotalRegistros="@Resultados.TotalRegistros" TamanoPagina="@TamanoPagina" />
    }
    <ConfirmDialog Abierto="@ConfirmarDesactivacion" Procesando="@Procesando"
                   Titulo="Desactivar servicio"
                   Mensaje="El servicio dejará de ofrecerse en nuevas reservas. Los turnos anteriores se conservan."
                   TextoConfirmar="Sí, desactivar" TextoCancelar="Volver"
                   OnConfirmar="DesactivarAsync" OnCancelar="CerrarConfirmacion" />
</section>

@code {
    private const int TamanoPagina = 10;
    private PaginaResultadoDto<ServicioDto> Resultados = new();
    private ServicioAdminFormModel Formulario = new() { DuracionMinutos = 30 };
    private string Busqueda = "";
    private string? Aviso, Error;
    private int Pagina = 1;
    private int? EditandoId, DesactivarId;
    private bool MostrarFormulario, ConfirmarDesactivacion, Procesando, Cargando;
    private int VersionBusqueda;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        var version = ++VersionBusqueda;
        Cargando = true;
        try
        {
            var datos = await ServiciosService.ListarAsync(Busqueda, Pagina, TamanoPagina);
            if (version == VersionBusqueda) Resultados = datos;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al listar servicios");
            if (version == VersionBusqueda) Error = "No se pudieron cargar los servicios.";
        }
        finally { if (version == VersionBusqueda) Cargando = false; }
    }
    private async Task BuscarAsync(string texto) { Busqueda = texto; Pagina = 1; await CargarAsync(); }
    private async Task CambiarPaginaAsync(int pagina) { Pagina = pagina; await CargarAsync(); }
    private void Nuevo() { Error = Aviso = null; EditandoId = null; Formulario = new() { DuracionMinutos = 30 }; MostrarFormulario = true; }
    private void Editar(ServicioDto dato)
    {
        Error = Aviso = null;
        EditandoId = dato.ServicioId;
        Formulario = new() { ServicioId = dato.ServicioId, Nombre = dato.Nombre, Descripcion = dato.Descripcion,
            Precio = dato.Precio, DuracionMinutos = dato.DuracionMinutos, ImagenUrl = dato.ImagenUrl, Activo = dato.Activo };
        MostrarFormulario = true;
    }
    private void CancelarEdicion() => MostrarFormulario = false;
    private async Task GuardarAsync()
    {
        if (Procesando) return;
        Procesando = true; Error = Aviso = null;
        try
        {
            // Convertimos el modelo visual validado al contrato de la capa Application.
            // No cambiamos las validaciones ni la lógica del backend.
            var datos = new ServicioFormDto
            {
                ServicioId = EditandoId,
                Nombre = Formulario.Nombre,
                Descripcion = Formulario.Descripcion,
                Precio = Formulario.Precio,
                DuracionMinutos = Formulario.DuracionMinutos,
                ImagenUrl = Formulario.ImagenUrl,
                Activo = Formulario.Activo
            };
            if (EditandoId.HasValue) await ServiciosService.ActualizarAsync(EditandoId.Value, datos);
            else await ServiciosService.CrearAsync(datos);
            MostrarFormulario = false;
            Aviso = "Servicio guardado correctamente.";
            Pagina = 1;
            await CargarAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al guardar servicio"); Error = "No se pudo guardar el servicio. Revisá los datos e intentá de nuevo."; }
        finally { Procesando = false; }
    }
    private void SolicitarDesactivar(ServicioDto dato) { DesactivarId = dato.ServicioId; ConfirmarDesactivacion = true; }
    private void CerrarConfirmacion() { ConfirmarDesactivacion = false; DesactivarId = null; }
    private async Task DesactivarAsync()
    {
        if (Procesando || DesactivarId is not int id) return;
        Procesando = true; Error = Aviso = null;
        try
        {
            await ServiciosService.DesactivarAsync(id);
            Aviso = "Servicio desactivado.";
            CerrarConfirmacion();
            await CargarAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al desactivar servicio"); Error = "No se pudo desactivar el servicio."; }
        finally { Procesando = false; }
    }
}
